# Flask Application Configuration
SECRET_KEY=your-secret-key-here
FLASK_APP=app.py
FLASK_DEBUG=1
SQLALCHEMY_DATABASE_URI=sqlite:///mydb.sqlite3

# Store Settings
STORE_NAME=TechStore
STORE_TIMEZONE=Asia/Phnom_Penh
LOW_STOCK_THRESHOLD=5
GRACE_PERIOD_HOURS=4
SCHEDULER_ENABLED=True

# Telegram Bot Notification Settings (Orders / General)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=@SETEC_PP_SHOP

# Telegram Security Alert Settings (Rate limit breaches / Attack alerts)
TELEGRAM_ALERT_BOT_TOKEN=your-telegram-alert-bot-token-here
TELEGRAM_ALERT_CHAT_ID=@pp_shop_alert

# Mail Settings (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
