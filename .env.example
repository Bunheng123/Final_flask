# ==============================================================================
# FLASK APPLICATION & CORE ENVIRONMENT CONFIGURATION
# ==============================================================================
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
FLASK_APP=app.py
FLASK_DEBUG=1
PORT=3000

# ==============================================================================
# DATABASE CONNECTION (SQLite / PostgreSQL / MySQL)
# ==============================================================================
# SQLite Default (Local Development):
SQLALCHEMY_DATABASE_URI=sqlite:///mydb.sqlite3

# PostgreSQL Example (Production / Staging):
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:123@localhost:5432/E-bookstrore_db

# MySQL Example:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:@localhost:3306/TechStore_db

# ==============================================================================
